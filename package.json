{
  "name": "tool-diet-audit",
  "private": true,
  "version": "0.1.0",
  "description": "macOS edge-drawer that audits your local Claude Code setup: idle MCP servers, cost, cache health, context bloat",
  "license": "MIT",
  "author": "Matjaz Grosek",
  "keywords": ["claude-code", "mcp", "electron", "macos", "token-usage"],
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "dist:mac:intel": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64"
  },
  "build": {
    "appId": "si.grosek.tool-diet-audit",
    "productName": "Tool Diet Audit",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["zip"]
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
